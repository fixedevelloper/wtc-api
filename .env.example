# Copier en .env pour le développement local avec compose.yaml. Ne JAMAIS committer .env.
DATABASE_URL=jdbc:postgresql://localhost:5432/wtc
DATABASE_USER=wtc
DATABASE_PASSWORD=change-me-locally

# Clé privée RSA (PEM PKCS#8) qui signe les jetons d'accès ; la clé publique en est déduite. Obligatoire.
# Pour n'avoir qu'une instance qui vérifie sans signer, fournir seulement WTC_SECURITY_JWT_PUBLIC_KEY_LOCATION.
WTC_SECURITY_JWT_PRIVATE_KEY_LOCATION=file:/chemin/vers/jwt-private.pem
# WTC_SECURITY_JWT_PUBLIC_KEY_LOCATION=file:/chemin/vers/jwt-public.pem
# Clé AES-256 en Base64 (32 octets) qui chiffre les secrets stockés : openssl rand -base64 32. Obligatoire.
# La perdre rend illisibles les secrets TOTP déjà enregistrés : la sauvegarder comme un secret de production.
WTC_SECURITY_ENCRYPTION_KEY=remplacer-par-la-sortie-de-openssl-rand-base64-32

# Stockage objet privé (pièces KYC, photos). En local : MinIO du compose.yaml ; en production : S3 ou équivalent.
# L'accès se fait uniquement par liens signés de courte durée ; le bucket ne doit JAMAIS être public.
WTC_STORAGE_ENDPOINT=http://localhost:9000
# WTC_STORAGE_PUBLIC_ENDPOINT=https://files.example.com   # si les liens signés doivent pointer vers un autre hôte
WTC_STORAGE_ACCESS_KEY=remplacer
WTC_STORAGE_SECRET_KEY=remplacer-par-un-secret-de-24-caracteres-minimum
WTC_STORAGE_BUCKET=wtc-private
# WTC_STORAGE_AUTO_CREATE_BUCKET=true   # développement uniquement : en production le bucket est provisionné

# Fournisseur de paiement : OBLIGATOIRE. « fake » = faux fournisseur (développement, tests) ; « wace » = réel.
WTC_PAYMENT_PROVIDER=fake
# Notifications : provider obligatoire par canal (fake = développement ; jamais en production)
WTC_NOTIFY_EMAIL_PROVIDER=fake        # smtp | fake | disabled (smtp : renseigner SPRING_MAIL_HOST, _PORT, _USERNAME, _PASSWORD)
WTC_NOTIFY_WHATSAPP_PROVIDER=fake     # waba | fake | disabled
WTC_NOTIFY_TELEGRAM_PROVIDER=fake     # telegram | fake | disabled
# WTC_NOTIFY_EMAIL_FROM=WTC <no-reply@votre-domaine>
# WTC_WABA_PHONE_NUMBER_ID=
# WTC_WABA_ACCESS_TOKEN=
# WTC_TELEGRAM_BOT_TOKEN=
# WTC_TELEGRAM_ADMIN_CHAT_ID=
# WTC_WEB_BASE_URL=https://app.votre-domaine
# Clé du chatbot WhatsApp pour /api/web-tokens (en-tête X-Service-Key) : longue, aléatoire ; vide = routes fermées
# WTC_SERVICE_KEY=
# WTC_TASKS_ENABLED=true               # tâches d'entretien (expiration KYC, purges)
# Avec « wace » : l'adresse IP de sortie doit être déclarée à Wace (liste blanche) ou un VPN établi.
# WTC_WACE_BASE_URL=https://recette.wace.example
# WTC_WACE_EMAIL=
# WTC_WACE_PASSWORD=

# Amorçage du premier super-administrateur (environnement neuf uniquement). Sans effet dès qu'un super-administrateur existe.
# Le compte devra activer son second facteur à la première connexion. Retirer ces deux lignes ensuite.
# WTC_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
# WTC_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
