# Copier en .env.prod (non versionné : voir .gitignore) et remplir. Détail de chaque variable : docs/runbook.md.

# Image déployée par la CI (ghcr.io/<propriétaire>/wtc-api:latest). Pour un retour arrière : un tag <sha> précédent.
WTC_IMAGE=ghcr.io/<propriétaire>/wtc-api:latest

# Port local de l'hôte vers lequel nginx redirige (8080 par défaut). À changer si un autre service occupe déjà 8080 :
# vérifier avec « sudo ss -ltnp | grep :8080 ». Ne PAS utiliser la variable PORT, réservée à l'application dans le conteneur.
# WTC_HOST_PORT=8080

DATABASE_USER=wtc
DATABASE_PASSWORD=

# AES-256 en Base64 : openssl rand -base64 32. La perdre rend illisibles les secrets TOTP : la sauvegarder à part de la base.
WTC_SECURITY_ENCRYPTION_KEY=
# La clé privée RSA (PKCS#8) est montée depuis ./secrets/jwt-private.pem (voir compose.prod.yaml).

# Stockage objet privé (S3 ou équivalent). Jamais de bucket public.
WTC_STORAGE_ENDPOINT=
WTC_STORAGE_ACCESS_KEY=
WTC_STORAGE_SECRET_KEY=
WTC_STORAGE_BUCKET=wtc-private
# WTC_STORAGE_REGION=us-east-1
# WTC_STORAGE_PUBLIC_ENDPOINT=
# WTC_STORAGE_PATH_STYLE=true

# Fournisseur de paiement : « wace » en production (« fake » est réservé au développement et aux tests).
# L'IP de sortie de cet hôte doit être déclarée à Wace (liste blanche) ou un VPN établi.
WTC_PAYMENT_PROVIDER=wace
WTC_WACE_BASE_URL=
WTC_WACE_EMAIL=
WTC_WACE_PASSWORD=

# Canaux de notification : smtp | waba | telegram | disabled (jamais « fake » en production).
WTC_NOTIFY_EMAIL_PROVIDER=
WTC_NOTIFY_WHATSAPP_PROVIDER=
WTC_NOTIFY_TELEGRAM_PROVIDER=

# Origines autorisées (CORS) et URL publique du back-office (liens de réinitialisation et d'invitation).
CORS_ALLOWED_ORIGINS=
WTC_WEB_BASE_URL=

# Premier démarrage seulement : crée le super-administrateur. À RETIRER dès qu'il existe.
# WTC_BOOTSTRAP_SUPER_ADMIN_EMAIL=
# WTC_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
